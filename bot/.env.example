# Copy to bot/.env and fill in. NEVER commit real values.
DISCORD_TOKEN=
DATABASE_URL=postgresql://mangabot:CHANGE_ME@localhost:5432/mangabot

# Translation (Ollama must be running locally)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_ALLOWED_MODELS=qwen2.5:7b-instruct,qwen2.5:14b-instruct
OLLAMA_CONTEXT_LENGTH=8192

# Limits
MAX_UPLOAD_MB=100     # حد حجم الملف المرفوع (ديسكورد نفسه: 10MB بدون Nitro)
MAX_PAGES=60
MAX_PAGES_TRANSLATE=30
MAX_ACTIVE_PER_USER=2
JOB_TIMEOUT_MINUTES=120
FILE_TTL_MINUTES=20
WORKERS=1
# USE_GPU=1   # الافتراضي: كشف تلقائي لـ NVIDIA GPU؛ ضع 0 لإجبار CPU

# Access control (comma separated IDs; empty = open)
# ALLOWED_GUILD_IDS=
# ADMIN_USER_IDS=

# احذف الأوامر القديمة الخاصة بالسيرفرات (من بوت قديم لنفس التطبيق) عند التشغيل
# PURGE_OLD_COMMANDS=1

# رفع النتائج الكبيرة (أكبر من حد ديسكورد) على gofile وإرسال رابط بدل الملف
# EXTERNAL_HOST=gofile
# GOFILE_TOKEN=          # اختياري: حسابك على gofile (بدونه يرفع كضيف)

# استقبال روابط Drive/Gofile بدل الرفع
# ALLOW_LINKS=1
# MAX_LINK_MB=500
# GOOGLE_API_KEY=       # لتفعيل روابط مجلدات Drive

# مفاتيح API لترجمة /chapter (اختياري؛ الموفر بدون مفتاح لا يعمل). لا تُرسل أبداً لمحرك التنظيف.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# XAI_API_KEY=
# TOGETHER_API_KEY=
