# Copy to bot/.env and fill in. NEVER commit real values.
DISCORD_TOKEN=
DATABASE_URL=postgresql://mangabot:CHANGE_ME@localhost:5432/mangabot

# Translation (Ollama must be running locally)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_ALLOWED_MODELS=qwen2.5:7b-instruct,qwen2.5:14b-instruct
OLLAMA_CONTEXT_LENGTH=8192

# Limits
MAX_UPLOAD_MB=25
MAX_PAGES=60
MAX_PAGES_TRANSLATE=30
MAX_ACTIVE_PER_USER=2
JOB_TIMEOUT_MINUTES=120
FILE_TTL_MINUTES=20
WORKERS=1
# USE_GPU=1

# Access control (comma separated IDs; empty = open)
# ALLOWED_GUILD_IDS=
# ADMIN_USER_IDS=
